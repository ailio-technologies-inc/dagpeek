{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dagpeek",
  "version": "0.9.0",
  "identifier": "com.ailio.dagpeek",
  "build": {
    "beforeDevCommand": "pnpm --filter @dagpeek/ui dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm --filter @dagpeek/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "popover",
        "title": "Dagpeek",
        "width": 380,
        "height": 540,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 Ailio Technologies Inc.",
    "shortDescription": "A menu bar and tray app for Dagu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyM0E2NjZGNjE4RTk2RjcKUldUM2xvNWhiMlk2TXRuVUt3M3E4QkQ5ai80UTEzY3ZzUFNMMW9HZDJVblFhUlJxOWRrcEJzeUEK",
      "endpoints": [
        "https://github.com/ailio-technologies-inc/dagpeek/releases/latest/download/latest.json"
      ]
    }
  }
}